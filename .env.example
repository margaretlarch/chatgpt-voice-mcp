# Copy to .dev.vars for local Wrangler development. Never commit .dev.vars.
# Configure all three providers for automatic fallback. Azure is last.
TTS_PROVIDER_PRIORITY=elevenlabs,cartesia,azure
TTS_PRIORITY_ASMR=elevenlabs,cartesia,azure
TTS_PRIORITY_CONVERSATION=cartesia,elevenlabs,azure
TTS_PRIORITY_GENERAL=elevenlabs,cartesia,azure
# Shown in MCP tool/player and used for the sample line. Runtime fallbacks: Voice / empty.
BOT_NAME=陆澈
USER_NAME=小橘

# Keep oauth for deployments. Set none only in local .dev.vars for short tests.
AUTH_MODE=oauth
# Exact public Worker origin, without a path or trailing slash.
AUTH_BASE_URL=
# Numeric GitHub account ID allowed to authorize this private Worker.
AUTH_ALLOWED_GITHUB_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# OAUTH_KV is a Cloudflare KV binding declared in wrangler.jsonc, not a secret here.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional language-specific voices
ELEVENLABS_VOICE_ID_ZH=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optional language-specific voices
CARTESIA_VOICE_ID_ZH=
CARTESIA_VOICE_ID_EN=
CARTESIA_MODEL_ID=sonic-3.6
CARTESIA_VERSION=2026-08-14

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE_ZH=zh-CN-XiaoxiaoNeural
AZURE_VOICE_EN=en-US-JennyNeural

# Legacy DashScope deployments remain supported.
# TTS_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# VOICE_ID=
